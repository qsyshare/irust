    use sha2::Sha256;

    type HmacSha256 = Hmac<Sha256>;
    type Db = Arc<Mutex<Vec<Record>>>;

    
    #[derive(Deserialize, Serialize, Clone)]
    struct Record {
        free_email: String,
        deadline: String,
        remaining: String,
        status: String,
        note: String,
    }

    #[derive(Serialize)]
    struct Stats {
        email_count: usize,
        status_count: usize,
        deadline_count: usize,
        remaining_count: usize,
    }
    

    #[derive(Deserialize)]
    struct InputRecord {
        free_email: String,
        deadline: String,
        remaining: Option<String>, // 设为可选
        status: String,
        note: String,
        password: String,
    }

    #[derive(Deserialize)]
    struct QueryInput {
        password: String,
    }

    #[derive(Deserialize)]
    struct ModifyInput {
        index: usize,
        password: String, // 添加密码字段
    }

    #[derive(Deserialize)]
    struct EditInput {
        index: usize,
        free_email: String,
        deadline: String,
        remaining: String,
        status: String,
        note: String,
        password: String,
        new_note: String,
    }

    #[derive(Serialize)]
    struct DisplayRecord {
        index: usize,  // 原始索引
        free_email: String,
        deadline: String,
        remaining: String,
        status: String,
        note: String,
    }


    
    fn encrypt_data(data: &str, password: &str) -> String {
        let salt = rand::thread_rng().r#gen::<[u8; 16]>();
        let iv = rand::thread_rng().r#gen::<[u8; 16]>();

        let mut key = [0u8; 32];
        pbkdf2::<HmacSha256>(password.as_bytes(), &salt, 10000, &mut key);

        let cipher = Cbc::<Aes256, Pkcs7>::new_from_slices(&key, &iv).unwrap();
        let ciphertext = cipher.encrypt_vec(data.as_bytes());

        let combined = [&salt[..], &iv[..], &ciphertext[..]].concat();
        general_purpose::STANDARD.encode(&combined)
    }

    fn decrypt_data(data: &str, password: &str) -> Option<String> {
        let decoded = general_purpose::STANDARD.decode(data).ok()?;
        let (salt, rest) = decoded.split_at(16);
        let (iv, encrypted_data) = rest.split_at(16);

        let mut key = [0u8; 32];
        pbkdf2::<HmacSha256>(password.as_bytes(), salt, 10000, &mut key);

        let cipher = Cbc::<Aes256, Pkcs7>::new_from_slices(&key, iv).ok()?;
        let decrypted_data = cipher.decrypt_vec(encrypted_data).ok()?;

        Some(String::from_utf8_lossy(&decrypted_data).to_string())
    }

    fn save_to_file(path: &str, data: &Vec<Record>) {
        let json = serde_json::to_string(data).unwrap();
        let mut file = File::create(path).unwrap();
        file.write_all(json.as_bytes()).unwrap();
    }

    fn load_from_file(path: &str) -> Vec<Record> {
        if let Ok(mut file) = File::open(path) {
            let mut json = String::new();
            file.read_to_string(&mut json).unwrap();
            serde_json::from_str(&json).unwrap_or_default()
        } else {
            Vec::new()
        }
    }



    #[tokio::main]
    async fn main() {
        let initial_data = load_from_file("data.json");
        let db: Db = Arc::new(Mutex::new(initial_data));
        let db_filter = warp::any().map({
            let db = db.clone();
            move || db.clone()
        });

        let index = warp::path!("index")
            .map(|| warp::reply::html(INDEX_HTML));


            let get_stats = warp::path!("stats")
            .and(warp::get())
            .and(db_filter.clone())
            .map(|db: Db| {
                let db_lock = db.lock().unwrap();
                let today = chrono::Local::now().naive_local().date();

                let mut email_count = 0;
                let mut status_count = 0;
                let mut deadline_count = 0;
                let mut remaining_count = 0;
                
                for record in db_lock.iter() {
                    if !record.free_email.is_empty() {
                        email_count += 1;
                    }
                
                    if record.deadline.is_empty(){
                        remaining_count += 1;
                   }
                
                    if let Ok(deadline_date) = chrono::NaiveDate::parse_from_str(&record.deadline, "%Y-%m-%d") {
                        if deadline_date < today {
                            deadline_count += 1;
                        } if deadline_date >= today {
                            status_count += 1;
                        }
                    }
                }
                

                warp::reply::json(&Stats {
                    email_count,
                    status_count,
                    deadline_count,
                    remaining_count,
                })
            });   



        let add_record = warp::path!("add")
            .and(warp::post())
            .and(warp::body::json())
            .and(db_filter.clone())
            .map(|input: InputRecord, db: Db| {

                
                let encrypted_email = encrypt_data(&input.free_email, &input.password);
                let encrypted_note = encrypt_data(&input.note, &input.password);

                // 自动计算 remaining
                let remaining = input.remaining.unwrap_or_else(|| {
                    let deadline_date = chrono::NaiveDate::parse_from_str(&input.deadline, "%Y-%m-%d")
                        .unwrap_or_else(|_| chrono::Local::now().naive_local().date());
                    let today = chrono::Local::now().naive_local().date();
                    let diff_days = (deadline_date - today).num_days();
                    diff_days.to_string()
                });

                let record = Record {
                    free_email: encrypted_email,
                    deadline: input.deadline,
                    remaining,
                    status: input.status,
                    note: encrypted_note,
                };


                let mut db_lock = db.lock().unwrap();
                db_lock.push(record);
                save_to_file("data.json", &db_lock);

                warp::reply::json(&serde_json::json!({ "status": "ok" }))
            });

        let query_records = warp::path!("query")
            .and(warp::get())
            .and(warp::query::<QueryInput>())
            .and(db_filter.clone())
            .map(|query: QueryInput, db: Db| {
                let db_lock = db.lock().unwrap();
                let mut decrypted_records = Vec::new();

                for (i, record) in db_lock.iter().enumerate() {
                    if let (Some(email), Some(note)) = (
                        decrypt_data(&record.free_email, &query.password),
                        decrypt_data(&record.note, &query.password),
                    ) {
                        decrypted_records.push(DisplayRecord {
                            index: i,
                            free_email: email,
                            deadline: record.deadline.clone(),
                            remaining: record.remaining.clone(),
                            status: record.status.clone(),
                            note,
                        });
                    }
                }
                
                warp::reply::json(&decrypted_records)
            });

            
            let delete_record = warp::path!("delete")
            .and(warp::post())
            .and(warp::body::json())
            .and(db_filter.clone())
            .map(|input: ModifyInput, db: Db| {
                let mut db_lock = db.lock().unwrap();
        
                if input.index < db_lock.len() {
                    let record = &db_lock[input.index];
        
                    // 尝试用输入的密码解密该记录邮箱
                    if decrypt_data(&record.free_email, &input.password).is_none() {
                        return warp::reply::json(&serde_json::json!({ "status": "wrong_password" }));
                    }
        
                    db_lock.remove(input.index);
                    save_to_file("data.json", &db_lock);  // 保存修改后的数据
                    return warp::reply::json(&serde_json::json!({ "status": "deleted" }));
                }
        
                warp::reply::json(&serde_json::json!({ "status": "error" }))
            });
        
        
            let edit_record = warp::path!("edit")
            .and(warp::post())
            .and(warp::body::json())
            .and(db_filter.clone())
            .map(|input: EditInput, db: Db| {
                let mut db_lock = db.lock().unwrap();
                if input.index < db_lock.len() {
                    let encrypted_email = encrypt_data(&input.free_email, &input.password);
                    let encrypted_note = encrypt_data(&input.new_note, &input.password);
        
                    // 更新记录
                    db_lock[input.index] = Record {
                        free_email: encrypted_email,
                        deadline: input.deadline,
                        remaining: input.remaining,   // 保持原样或进行更新
                        status: input.status,         // 更新状态
                        note: encrypted_note,
                    };
                    save_to_file("data.json", &db_lock);  // 保存修改后的数据
                    return warp::reply::json(&serde_json::json!({ "status": "edited" }));
                }
                warp::reply::json(&serde_json::json!({ "status": "error" }))
            });
        

    
        let routes = index
        .or(add_record)
        .or(query_records)
        .or(delete_record)
        .or(edit_record)
        .or(get_stats);

        warp::serve(routes).run(([127, 0, 0, 1], 3030)).await;
    }

